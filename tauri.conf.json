{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lenstica",
  "identifier": "com.lenstica.app",
  "build": {
    "frontendDist": "assets/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Supply-chain guard for developer machines",
    "longDescription": "Keeps every package manager from installing versions newer than N days, and watches installed packages for vulnerabilities, malware and deprecations, and the machine for exposed secrets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "license": "Apache-2.0",
    "licenseFile": "LICENSE"
  }
}
